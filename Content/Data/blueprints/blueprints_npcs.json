[
  // ── Village NPCs (story) ──────────────────────────────────────────────────
  {
    "id":             "npc_elder",
    "name":           "Elder Maren",
    "spriteKey":      "npc_elder",
    "colorTint":      "#FFDD88",
    "blocksMovement": true,
    "isPeaceful":     true,
    "hasDialogue":    true,
    "dialogueLines": [
      "Welcome to Millhaven, adventurer.",
      "Dark creatures have crept up from the depths beneath our town.",
      "If you are brave enough, descend into the dungeon and push them back.",
      "Return when you have reached the sixth level. Only then will we be safe.",
      "May fortune guide your blade."
    ]
  },
  {
    "id":             "npc_merchant",
    "name":           "Davan the Merchant",
    "spriteKey":      "npc_merchant",
    "colorTint":      "#88DD88",
    "blocksMovement": true,
    "isPeaceful":     true,
    "hasDialogue":    true,
    "dialogueLines": [
      "Finest goods in all of Millhaven!",
      "Well... I had goods. The last caravan was attacked on the road.",
      "Whatever you find down there, keep it. I am out of stock for now.",
      "Come back once this mess is sorted and I'll give you a real discount."
    ]
  },
  {
    "id":             "npc_guard",
    "name":           "Guard Ollen",
    "spriteKey":      "npc_guard",
    "colorTint":      "#8899CC",
    "blocksMovement": true,
    "isPeaceful":     true,
    "hasDialogue":    true,
    "dialogueLines": [
      "Halt! ...Actually, go ahead.",
      "We are stretched thin. Half the guard went down and didn't come back.",
      "The entrance to the dungeon is to the south. Watch your step.",
      "If you find any of our gear down there, it's yours."
    ]
  },
  {
    "id":             "npc_villager_a",
    "name":           "Petra",
    "spriteKey":      "npc_villager",
    "colorTint":      "#DDBB88",
    "blocksMovement": true,
    "isPeaceful":     true,
    "hasDialogue":    true,
    "dialogueLines": [
      "My husband went into the dungeon three days ago.",
      "He said it would only take an hour.",
      "Please, if you find him... his name is Rolf."
    ]
  },
  {
    "id":             "npc_villager_b",
    "name":           "Old Hessa",
    "spriteKey":      "npc_villager",
    "colorTint":      "#CCAA99",
    "blocksMovement": true,
    "isPeaceful":     true,
    "hasDialogue":    true,
    "dialogueLines": [
      "I remember when this town had music.",
      "Now all we hear are those awful sounds from below.",
      "Every night. Every single night.",
      "Bring peace to this place, will you?"
    ]
  },
  {
    "id":             "npc_villager_c",
    "name":           "Young Tam",
    "spriteKey":      "npc_villager",
    "colorTint":      "#EECC88",
    "blocksMovement": true,
    "isPeaceful":     true,
    "hasDialogue":    true,
    "dialogueLines": [
      "Are you really going down there?",
      "I heard there are trolls on the lower levels.",
      "I want to be an adventurer one day too!",
      "Just... maybe not today."
    ]
  },
  {
    "id":             "npc_villager_d",
    "name":           "Mira the Smith",
    "spriteKey":      "npc_villager",
    "colorTint":      "#BBBBBB",
    "blocksMovement": true,
    "isPeaceful":     true,
    "hasDialogue":    true,
    "dialogueLines": [
      "My forge is cold. No iron to work.",
      "Dungeon's cursed the supply routes.",
      "Find a weapon down there. They're not pretty but they'll hold.",
      "Aim for the joints on the bigger ones."
    ]
  },

  // ── Village NPCs (shop / interactive) ─────────────────────────────────────
  {
    "id": "npc_blacksmith",
    "name": "Blacksmith",
    "spriteKey": "npc_blacksmith",
    "colorTint": "#CCCCCC",
    "blocksMovement": true,
    "isPeaceful": true,
    "hasDialogue": true,
    "hasInventory": true,
    "inventorySlots": 20,
    "startingGold": 120,
    "shopInventory": [
      "item_battle_axe",
      "item_leather_armor",
      "item_health_potion"
    ],
    "dialogPool": {
      "after_quest_completed:quest_chop_wood": [
        "Good work. Water and wood both sorted - the forge is running again.",
        "Now get out there and make yourself useful. Those wolves won't cull themselves."
      ],
      "after_quest_completed:quest_fetch_water": [
        "Water's in, good. Now we need fuel for the fire.",
        "Chop some logs from the trees out back and process them into planks at the forge."
      ],
      "requires_background:background_blacksmith_child": [
        "Ah, there you are kid. We need to stay productive.",
        "The well is dried up and we need water for quenching. Grab the bucket and head to the river.",
        "Then chop some wood. We need logs to turn into planks.",
        "Oh, and wolves have been raiding the livestock at night. Cull 5 of them when you get the chance."
      ],
      "default": [
        "Welcome to the forge. I buy pelts and tusks - sell me what you find.",
        "Need gear? I've got axes, armour, and potions. Gold talks."
      ]
    },
    "dialogOptions": [
      { "id": "barter",   "label": "What have you got for sale?", "action": "open_shop" },
      { "id": "farewell", "label": "Farewell.",                   "action": "close"     }
    ]
  },
  {
    "id": "npc_herbalist",
    "name": "Wren the Herbalist",
    "spriteKey": "npc_herbalist",
    "colorTint": "#88CC88",
    "blocksMovement": true,
    "isPeaceful": true,
    "hasDialogue": true,
    "hasInventory": true,
    "inventorySlots": 15,
    "startingGold": 40,
    "shopInventory": [
      "item_health_potion",
      "item_health_potion",
      "item_bandage",
      "item_bandage",
      "item_bandage"
    ],
    "dialogPool": {
      "after_quest_completed:quest_cull_wolves": [
        "Fewer wolves means I can gather herbs without watching my back.",
        "My stock is fuller for it. Come see me when you need patching up."
      ],
      "requires_background:background_blacksmith_child": [
        "Your father used to send metal scraps my way for the herb press.",
        "I've kept a few bandages aside for his family. Take what you need."
      ],
      "default": [
        "Potions and bandages - everything you need to keep breathing out there.",
        "The wilderness takes a toll. Come back in one piece and I'll keep you patched up."
      ]
    },
    "dialogOptions": [
      { "id": "barter",   "label": "What do you have?", "action": "open_shop" },
      { "id": "farewell", "label": "Farewell.",         "action": "close"     }
    ]
  },
  {
    "id": "npc_trader",
    "name": "Voss the Trader",
    "spriteKey": "npc_trader",
    "colorTint": "#DDAA44",
    "blocksMovement": true,
    "isPeaceful": true,
    "hasDialogue": true,
    "hasInventory": true,
    "inventorySlots": 20,
    "startingGold": 100,
    "shopInventory": [
      "item_dagger",
      "item_sword",
      "item_shield",
      "item_chainmail"
    ],
    "dialogPool": {
      "after_quest_completed:quest_cull_wolves": [
        "With those wolves gone the trade roads might open up again.",
        "I'll have more stock coming in soon. Buy what I've got for now."
      ],
      "requires_background:background_blacksmith_child": [
        "The blacksmith's own kid. Your father kept my cart rolling more than once.",
        "Good steel for a fair price - that's how we do business."
      ],
      "default": [
        "Blades, shields, and mail - everything the well-prepared adventurer carries.",
        "I buy quality gear too. Find something good out there, bring it back."
      ]
    },
    "dialogOptions": [
      { "id": "barter",   "label": "Show me your wares.", "action": "open_shop" },
      { "id": "farewell", "label": "Farewell.",           "action": "close"     }
    ]
  },
  {
    "id": "npc_villager",
    "name": "Villager",
    "spriteKey": "npc_villager",
    "colorTint": "#DDBB88",
    "blocksMovement": true,
    "isPeaceful": true,
    "hasDialogue": true,
    "dialogPool": {
      "default": [
        "Another quiet day."
      ],
      "requires_background:background_blacksmith_child": [
        "Ah, the smith's kid! How is your father?"
      ]
    }
  }
]
