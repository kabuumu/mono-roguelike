[
  // ── Village NPCs (story) ──────────────────────────────────────────────────
  {
    "id":             "npc_elder",
    "name":           "Elder Maren",
    "spriteKey":      "npc_elder",
    "colorTint":      "#FFDD88",
    "blocksMovement": true,
    "isPeaceful":     true,
    "hasDialogue":    true,
    "dialogPool": {
      "after_quest_completed:quest_cave_scout": [
        "You went in and came back out. That's more than most.",
        "Stay safe out there. The caverns go deeper than anyone knows."
      ],
      "default": [
        "Welcome to Millhaven, adventurer.",
        "Dark creatures have crept up from the depths beneath our town.",
        "The Crystal Caverns to the east concern me most - we need to know what stirs in there.",
        "Return when you have reached the sixth level of the dungeon. Only then will we be safe.",
        "May fortune guide your blade."
      ]
    },
    "dialogOptions": [
      { "id": "scout_cave", "label": "I'll scout the caverns.",  "action": "give_quest:quest_cave_scout" },
      { "id": "farewell",   "label": "Farewell.",                "action": "close" }
    ]
  },
  {
    "id":             "npc_merchant",
    "name":           "Davan the Merchant",
    "spriteKey":      "npc_merchant",
    "colorTint":      "#88DD88",
    "blocksMovement": true,
    "isPeaceful":     true,
    "hasDialogue":    true,
    "dialogueLines": [
      "Finest goods in all of Millhaven!",
      "Well... I had goods. The last caravan was attacked on the road.",
      "Whatever you find down there, keep it. I am out of stock for now.",
      "Come back once this mess is sorted and I'll give you a real discount."
    ]
  },
  {
    "id":             "npc_guard",
    "name":           "Guard Ollen",
    "spriteKey":      "npc_guard",
    "colorTint":      "#8899CC",
    "blocksMovement": true,
    "isPeaceful":     true,
    "hasDialogue":    true,
    "dialogPool": {
      "after_quest_completed:quest_boar_cull": [
        "The food stores are intact. Good work.",
        "Stay out of trouble - or don't, I suppose that's the point."
      ],
      "default": [
        "Halt! ...Actually, go ahead.",
        "We are stretched thin. Half the guard went down and didn't come back.",
        "Boars have been breaking into the food stores at the north edge of town. Three of them.",
        "If you deal with that, I'll make it worth your while."
      ]
    },
    "dialogOptions": [
      { "id": "boar_cull", "label": "I'll handle the boars.", "action": "give_quest:quest_boar_cull" },
      { "id": "farewell",  "label": "Farewell.",              "action": "close" }
    ]
  },
  {
    "id":             "npc_villager_a",
    "name":           "Petra",
    "spriteKey":      "npc_villager",
    "colorTint":      "#DDBB88",
    "blocksMovement": true,
    "isPeaceful":     true,
    "hasDialogue":    true,
    "dialogueLines": [
      "My husband went into the dungeon three days ago.",
      "He said it would only take an hour.",
      "Please, if you find him... his name is Rolf."
    ]
  },
  {
    "id":             "npc_villager_b",
    "name":           "Old Hessa",
    "spriteKey":      "npc_villager",
    "colorTint":      "#CCAA99",
    "blocksMovement": true,
    "isPeaceful":     true,
    "hasDialogue":    true,
    "dialogueLines": [
      "I remember when this town had music.",
      "Now all we hear are those awful sounds from below.",
      "Every night. Every single night.",
      "Bring peace to this place, will you?"
    ]
  },
  {
    "id":             "npc_villager_c",
    "name":           "Young Tam",
    "spriteKey":      "npc_villager",
    "colorTint":      "#EECC88",
    "blocksMovement": true,
    "isPeaceful":     true,
    "hasDialogue":    true,
    "dialogueLines": [
      "Are you really going down there?",
      "I heard there are trolls on the lower levels.",
      "I want to be an adventurer one day too!",
      "Just... maybe not today."
    ]
  },
  {
    "id":             "npc_villager_d",
    "name":           "Mira the Smith",
    "spriteKey":      "npc_villager",
    "colorTint":      "#BBBBBB",
    "blocksMovement": true,
    "isPeaceful":     true,
    "hasDialogue":    true,
    "dialogueLines": [
      "My forge is cold. No iron to work.",
      "Dungeon's cursed the supply routes.",
      "Find a weapon down there. They're not pretty but they'll hold.",
      "Aim for the joints on the bigger ones."
    ]
  },

  // ── Village NPCs (shop / interactive) ─────────────────────────────────────
  {
    "id": "npc_blacksmith",
    "name": "Blacksmith",
    "spriteKey": "npc_blacksmith",
    "colorTint": "#CCCCCC",
    "blocksMovement": true,
    "isPeaceful": true,
    "hasDialogue": true,
    "hasInventory": true,
    "inventorySlots": 20,
